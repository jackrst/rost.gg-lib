local lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/jackrst/rost.gg-lib/main/script"))()
local window = lib:CreateWindow("ESP Menu")

-- Drawing API tables
local espBoxes = {}
local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1
fovCircle.NumSides = 100
fovCircle.Radius = 100
fovCircle.Color = Color3.fromRGB(0, 255, 200)
fovCircle.Filled = false
fovCircle.Visible = false

-- Toggle: FOV Circle
lib:AddToggle(window.Container, "Show FOV", function(state)
    fovCircle.Visible = state
end)

-- Toggle: Box ESP
lib:AddToggle(window.Container, "Box ESP", function(state)
    for _, box in pairs(espBoxes) do
        box.Visible = state
    end
end)

-- ESP Loop
game:GetService("RunService").RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    local localPlayer = game.Players.LocalPlayer

    fovCircle.Position = uis:GetMouseLocation()

    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)

            if not espBoxes[player] then
                local box = Drawing.new("Square")
                box.Color = Color3.fromRGB(0, 255, 0)
                box.Thickness = 1
                box.Filled = false
                box.Transparency = 1
                box.Visible = true
                espBoxes[player] = box
            end

            local box = espBoxes[player]
            if onScreen then
                box.Size = Vector2.new(60, 100)
                box.Position = Vector2.new(screenPos.X - 30, screenPos.Y - 100 / 2)
                box.Visible = true
            else
                box.Visible = false
            end
        end
    end
end)

-- Cleanup on player leave
game.Players.PlayerRemoving:Connect(function(player)
    if espBoxes[player] then
        espBoxes[player]:Remove()
        espBoxes[player] = nil
    end
end)
